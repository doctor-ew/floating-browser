{
  "$comment": [
    "Active routing consumed by scripts/nightshift-agent.sh. Exact role/gear routes are required.",
    "Provider envelopes are normalized and validated locally against strict role contracts.",
    "Connexure: Codex Sol for ordinary work, Astra for escalation; Claude for independent review and chat. Local providers are prohibited."
  ],
  "version": 1,
  "providers": {
    "claude": {
      "cmd": "claude",
      "args": [
        "-p",
        "--output-format",
        "json"
      ],
      "model_flag": "--model",
      "agent_flag": "--agents",
      "schema_enforced": true,
      "$comment": "Role body is injected inline via --agents <json>; no ~/.claude/agents install needed."
    },
    "codex": {
      "cmd": "codex",
      "args": [
        "exec",
        "--json",
        "--skip-git-repo-check"
      ],
      "model_flag": "--model",
      "schema_flag": "--output-schema",
      "sandbox_flag": "--sandbox",
      "schema_enforced": true,
      "$comment": "codex exec enforces the JSON return contract at the provider via --output-schema."
    },
    "local": {
      "cmd": "codex",
      "args": [
        "exec",
        "--oss",
        "--local-provider",
        "ollama",
        "--json",
        "--skip-git-repo-check"
      ],
      "model_flag": "-m",
      "schema_flag": "--output-schema",
      "sandbox_flag": "--sandbox",
      "schema_enforced": true,
      "$comment": "Codex supplies the agentic tool loop around a local model. Do not hand-roll one. Requires a coding-tuned model in the 14B-32B range; llama3.2:3b is not adequate for any role here."
    }
  },
  "defaults": {
    "provider": "codex",
    "sandbox": "read-only"
  },
  "roles": {
    "nightshift-code-fact-extractor": {
      "prompt": "agents/nightshift-code-fact-extractor.md",
      "sandbox": "read-only",
      "gears": {
        "1": {
          "provider": "codex",
          "model": "gpt-6-sol"
        },
        "2": {
          "provider": "codex",
          "model": "gpt-6-sol"
        },
        "3": {
          "provider": "codex",
          "model": "gpt-6-astra"
        },
        "4": {
          "provider": "codex",
          "model": "gpt-6-astra"
        }
      },
      "$comment": "Role prompts remain runtime-neutral; provider selection is configured here."
    },
    "nightshift-spec-writer": {
      "prompt": "agents/nightshift-spec-writer.md",
      "sandbox": "read-only",
      "gears": {
        "1": {
          "provider": "codex",
          "model": "gpt-6-sol"
        },
        "2": {
          "provider": "codex",
          "model": "gpt-6-sol"
        },
        "3": {
          "provider": "codex",
          "model": "gpt-6-astra"
        },
        "4": {
          "provider": "codex",
          "model": "gpt-6-astra"
        }
      },
      "$comment": "Role prompts remain runtime-neutral; provider selection is configured here."
    },
    "nightshift-engineer": {
      "prompt": "agents/nightshift-engineer.md",
      "sandbox": "workspace-write",
      "gears": {
        "1": {
          "provider": "codex",
          "model": "gpt-6-sol"
        },
        "2": {
          "provider": "codex",
          "model": "gpt-6-sol"
        },
        "3": {
          "provider": "codex",
          "model": "gpt-6-astra"
        },
        "4": {
          "provider": "codex",
          "model": "gpt-6-astra"
        }
      },
      "$comment": "Role prompts remain runtime-neutral; provider selection is configured here."
    },
    "nightshift-architect": {
