        }
      },
      "$comment": "Role prompts remain runtime-neutral; provider selection is configured here."
    }
  },
  "adversarial": {
    "cross_provider": true,
    "$comment": [
      "With --adversarial, cross_provider requires actual --author-provider provenance.",
      "Retain a different primary or use the first different-provider alternate; fail closed if none exists."
    ],
    "routes": [
      {
        "provider": "codex",
        "model": "gpt-6-sol"
      },
      {
        "provider": "claude",
        "model": "sonnet"
      }
    ]
  },
  "profiles": {
    "workshop": {
      "provider": "claude",
      "writer_model": "sonnet",
      "reviewer_model": "sonnet",
      "cross_provider": false,
      "review_isolation": "fresh tool-free session; human spec approval"
    }
  },
  "allowed_providers": [
    "codex",
    "claude"
  ],
  "chat": {
    "provider": "claude",
    "model": "sonnet"
  }
}
